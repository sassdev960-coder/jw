{
  "entities": {
    "Member": {
      "title": "Member",
      "description": "Perfil de un publicador o siervo de la congregación",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "gender": { "type": "string", "enum": ["M", "F"] },
        "role": { "type": "string", "enum": ["anciano", "siervo_ministerial", "publicador", "precursor"] },
        "phone": { "type": "string", "maxLength": 30 },
        "privileges": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "gender", "role"]
    },
    "Assignment": {
      "title": "Assignment",
      "description": "Asignación teocrática o turno programado",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 150 },
        "section": { "type": "string" },
        "meetingType": { "type": "string" },
        "date": { "type": "string", "maxLength": 20 },
        "time": { "type": "string", "maxLength": 10 },
        "assigneeId": { "type": "string" },
        "assigneeName": { "type": "string", "maxLength": 100 },
        "assigneeRole": { "type": "string" },
        "assistantId": { "type": "string" },
        "assistantName": { "type": "string" },
        "hall": { "type": "string" },
        "lessonOrStudy": { "type": "string" },
        "source": { "type": "string" },
        "notes": { "type": "string" },
        "status": { "type": "string", "enum": ["pendiente", "confirmado", "completado", "sustituido"] },
        "completedAt": { "type": "string" },
        "completionNotes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "section", "meetingType", "date", "time", "assigneeId", "assigneeName", "status"]
    },
    "AppNotification": {
      "title": "AppNotification",
      "description": "Notificación o recordatorio de asignación teocrática",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "assignmentId": { "type": "string" },
        "title": { "type": "string", "maxLength": 150 },
        "message": { "type": "string", "maxLength": 500 },
        "type": { "type": "string" },
        "daysRemaining": { "type": "number" },
        "dateTarget": { "type": "string" },
        "createdAt": { "type": "string" },
        "read": { "type": "boolean" }
      },
      "required": ["id", "userId", "title", "message", "type", "dateTarget", "read"]
    }
  },
  "firestore": {
    "/members/{memberId}": {
      "schema": "Member",
      "description": "Colección de perfiles de hermanos y publicadores"
    },
    "/assignments/{assignmentId}": {
      "schema": "Assignment",
      "description": "Colección de asignaciones teocráticas y turnos"
    },
    "/notifications/{notificationId}": {
      "schema": "AppNotification",
      "description": "Colección de notificaciones y recordatorios"
    }
  }
}
